Bootstrap: docker
From: condaforge/miniforge3

%labels
    Author ChronoRoot Team
    Version v1.0
    Description ChronoRootAnnotationSuite using Conda (Named Env)

%post
    # 1. Create a named environment ('chronoroot') instead of using base.
    conda create -y -n chronoRootAnnotation python=3.10 \
        numpy \
        opencv \
        nibabel \
        scipy \
        pyqt \
        mesalib \
        xorg-libx11 \
        xorg-libxext \
        xorg-libxrender \
        xorg-libxi \
        scikit-image \
        pandas \
        seaborn

    # 2. Clean up to reduce image size
    conda clean -afy

%environment
    # Point the PATH directly to the new named environment's bin folder
    export PATH=/opt/conda/envs/chronoRootAnnotation/bin:$PATH
    
    export QT_X11_NO_MITSHM=1
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    echo "Starting ChronoRoot Annotation Suite (Environment: chronoRootAnnotation)..."
    exec python "$@"